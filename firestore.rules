rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función central de seguridad (RBAC & Tenant Isolation)
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Asume que cada documento tiene un campo 'empresaId' o 'userId'
    function belongsToUser() {
      return resource.data.userId == request.auth.uid || resource.data.empresaId == request.auth.token.empresaId;
    }
    
    function isOwnerCreating() {
      return request.resource.data.userId == request.auth.uid || request.resource.data.empresaId == request.auth.token.empresaId;
    }

    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    match /config/{docId} {
      allow read: if isAuthenticated(); // Config global pública para usuarios firmados
      allow write: if false; // Solo admin desde la consola puede cambiar configs globales
    }

    // Regla global por defecto para colecciones empresariales
    match /{collection}/{docId} {
      allow read, update, delete: if isAuthenticated() && belongsToUser();
      allow create: if isAuthenticated() && isOwnerCreating();
    }
  }
}
